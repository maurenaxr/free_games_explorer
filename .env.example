# Copy this file to ".env" and adjust the values if needed.
# The FreeToGame API does not need an API key.

# Port the Express server listens on
PORT=3000

# Base URL of the external API
API_BASE_URL=https://www.freetogame.com/api

# Axios timeout in milliseconds (how long we wait for the API)
REQUEST_TIMEOUT_MS=10000

# How long (in seconds) API answers are kept in the in-memory cache
CACHE_TTL_SECONDS=300
